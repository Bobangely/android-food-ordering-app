<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:id="@+id/main"
    android:layout_height="match_parent"
    android:background="#F4F4F4"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">


        <LinearLayout
            android:layout_marginTop="25dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/pill_background"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="4dp">

                <TextView
                    android:id="@+id/tab_dine_in"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="Dine In"
                    android:gravity="center"
                    android:background="@drawable/tab_selected"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tab_take_away"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="Take Away"
                    android:gravity="center"
                    android:textStyle="bold"
                    android:textColor="#888"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground" />


            </LinearLayout>

            <ImageButton
                android:id="@+id/cart"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_cart"
                android:layout_marginLeft="16dp"
                android:elevation="4dp"
                android:contentDescription="Cart Button" />

            <ImageButton
                android:id="@+id/btn_logout"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/powerbtn"
                android:layout_marginLeft="8dp"
                android:elevation="4dp"
                android:contentDescription="Logout Button" />
        </LinearLayout>



        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:background="@drawable/category_card"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:layout_marginRight="12dp">

                    <ImageButton
                        android:id="@+id/ic_promo"
                        android:layout_width="40dp"
                        android:layout_height="45dp"
                        android:src="@drawable/ic_promo"
                        android:contentDescription="Promotions" />

                    <TextView
                        android:layout_width="40dp"
                        android:layout_height="20dp"
                        android:textStyle="bold"
                        android:text=" Promo"
                        android:textSize="12dp"
                        android:textColor="#333"
                        />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:background="@drawable/category_card"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:layout_marginRight="12dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_pizza" />

                    <TextView
                        android:layout_width="40dp"
                        android:layout_height="20dp"
                        android:textStyle="bold"
                        android:text="  Pizza"
                        android:textSize="12dp"
                        android:textColor="#333"/>
                </LinearLayout>


                <LinearLayout
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:background="@drawable/category_card"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:layout_marginRight="12dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_sushi" />

                    <TextView
                        android:layout_width="40dp"
                        android:layout_height="20dp"
                        android:textStyle="bold"
                        android:text="  Sushi"
                        android:textSize="12dp"
                        android:textColor="#333"/>
                </LinearLayout>


                <LinearLayout
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:background="@drawable/category_card"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_burger" />

                    <TextView
                        android:layout_width="40dp"
                        android:layout_height="20dp"
                        android:textStyle="bold"
                        android:text=" Burger"
                        android:textSize="12dp"
                        android:textColor="#333"/>
                </LinearLayout>

            </LinearLayout>
        </HorizontalScrollView>



        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:background="@drawable/banner_yellow"
            android:orientation="horizontal"
            android:layout_marginTop="16dp"
            android:padding="16dp"
            android:gravity="center_vertical">

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <TextView
                    android:layout_width="200dp"
                    android:layout_height="25dp"
                    android:text="Best Deal For Today"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:textColor="#333"/>

                <TextView
                    android:layout_width="180dp"
                    android:layout_height="35dp"
                    android:text="Grab our mouthwatering taco deal before it's gone!"
                    android:textColor="#444"
                    android:textSize="14sp" />

                <Button
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="Get 20% Off"
                    android:backgroundTint="#000000"
                    android:textColor="#fff"
                    android:padding="8dp"
                    android:layout_marginTop="8dp"/>
            </LinearLayout>

            <ImageView
                android:layout_width="170dp"
                android:layout_height="170dp"
                android:scaleType="centerCrop"
                android:src="@drawable/banner_food" />
        </LinearLayout>



        <TextView
            android:layout_width="150dp"
            android:layout_height="25dp"
            android:text="Top Rated Food"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="#222"
            android:layout_marginTop="24dp"/>

        <GridLayout
            android:id="@+id/grid_food"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:layout_marginTop="12dp">


            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:background="@drawable/card_food"
                android:orientation="vertical"
                android:padding="10dp"
                android:layout_margin="8dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:src="@drawable/pizza1"
                    android:scaleType="centerCrop"
                    android:background="@drawable/rounded_image"/>

                <TextView
                    android:layout_width="160dp"
                    android:layout_height="25dp"
                    android:text="Savory Mushroom Pizza"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:layout_marginTop="6dp"/>


                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="$12.99"
                        android:textColor="#0a8f08"
                        android:textSize="16sp"
                        android:layout_weight="1"/>
                </LinearLayout>

                <Button
                    android:id="@+id/add_to_cart1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Add to Cart"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="#FF5722"
                    android:textColor="#FFFFFF" />

            </LinearLayout>




            <LinearLayout
                android:layout_width="0dp"

                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:background="@drawable/card_food"
                android:orientation="vertical"
                android:padding="10dp"
                android:layout_margin="8dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:src="@drawable/burger1"
                    android:scaleType="centerCrop"
                    android:background="@drawable/rounded_image"/>

                <TextView
                    android:layout_width="160dp"
                    android:layout_height="25dp"
                    android:text="Classic Smash Burger"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:layout_marginTop="6dp"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="$6.99"
                        android:textColor="#0a8f08"
                        android:textSize="16sp"
                        android:layout_weight="1"/>

                </LinearLayout>

                <Button
                    android:id="@+id/add_to_cart2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Add to Cart"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="#FF5722"
                    android:textColor="#FFFFFF" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:background="@drawable/card_food"
                android:orientation="vertical"
                android:padding="10dp"
                android:layout_margin="8dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:src="@drawable/ramen"
                    android:scaleType="centerCrop"
                    android:background="@drawable/rounded_image"/>

                <TextView
                    android:layout_width="160dp"
                    android:layout_height="25dp"
                    android:text="Miso Ramen"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:layout_marginTop="6dp"/>

                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="$9.99"
                        android:textColor="#0a8f08"
                        android:textSize="16sp"
                        android:layout_weight="1"/>

                </LinearLayout>

                <Button
                    android:id="@+id/add_to_cart3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Add to Cart"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="#FF5722"
                    android:textColor="#FFFFFF" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:background="@drawable/card_food"
                android:orientation="vertical"
                android:padding="10dp"
                android:layout_margin="8dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:src="@drawable/tomyumkung"
                    android:scaleType="centerCrop"
                    android:background="@drawable/rounded_image"/>

                <TextView
                    android:layout_width="160dp"
                    android:layout_height="25dp"
                    android:text="Tom yum kung"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:layout_marginTop="6dp"/>

                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="$7.99"
                        android:textColor="#0a8f08"
                        android:textSize="16sp"
                        android:layout_weight="1"/>

                </LinearLayout>

                <Button
                    android:id="@+id/add_to_cart4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Add to Cart"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="#FF5722"
                    android:textColor="#FFFFFF" />

            </LinearLayout>


            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:background="@drawable/card_food"
                android:orientation="vertical"
                android:padding="10dp"
                android:layout_margin="8dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:src="@drawable/shushi"
                    android:scaleType="centerCrop"
                    android:background="@drawable/rounded_image"/>

                <TextView
                    android:layout_width="160dp"
                    android:layout_height="25dp"
                    android:text="Sushi Platter"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:layout_marginTop="6dp"/>

                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="$11.49"
                        android:textColor="#0a8f08"
                        android:textSize="16sp"
                        android:layout_weight="1"/>

                </LinearLayout>

                <Button
                    android:id="@+id/add_to_cart5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Add to Cart"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="#FF5722"
                    android:textColor="#FFFFFF" />

            </LinearLayout>


            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:background="@drawable/card_food"
                android:orientation="vertical"
                android:padding="10dp"
                android:layout_margin="8dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:src="@drawable/spaghetti"
                    android:scaleType="centerCrop"
                    android:background="@drawable/rounded_image"/>

                <TextView
                    android:layout_width="160dp"
                    android:layout_height="25dp"
                    android:text="Spaghetti Carbonara"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:layout_marginTop="6dp"/>

                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="$8.49"
                        android:textColor="#0a8f08"
                        android:textSize="16sp"
                        android:layout_weight="1"/>

                </LinearLayout>

                <Button
                    android:id="@+id/add_to_cart6"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Add to Cart"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="#FF5722"
                    android:textColor="#FFFFFF" />

            </LinearLayout>




        </GridLayout>

    </LinearLayout>
</ScrollView>
