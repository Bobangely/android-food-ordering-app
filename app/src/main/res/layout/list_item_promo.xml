<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="200dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="8dp"
    android:layout_margin="8dp"
    android:background="@drawable/promo_card_bg"
    android:elevation="4dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:foreground="?attr/selectableItemBackground">

        <ImageView
            android:id="@+id/promo_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/pizza1"
            android:adjustViewBounds="true"
            android:contentDescription="Promo image" />

        <TextView
            android:id="@+id/promo_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:layout_gravity="top|start"
            android:background="#AA000000"
            android:padding="4dp"
            android:text="14:00"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <CheckBox
            android:id="@+id/promo_select"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_margin="8dp"
            android:layout_gravity="top|end"
            android:buttonTint="#0B6E4F"
            android:background="@android:color/transparent" />

    </FrameLayout>

    <TextView
        android:id="@+id/promo_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ชื่อสินค้า"
        android:textColor="#222"
        android:textStyle="bold"
        android:layout_marginTop="8dp"
        android:maxLines="2"
        android:ellipsize="end"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/promo_merchant"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ร้านค้า"
        android:textColor="#777"
        android:textSize="12sp"
        android:layout_marginTop="2dp" />

    <TextView
        android:id="@+id/promo_price"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="฿0.00"
        android:textColor="#E53935"
        android:textStyle="bold"
        android:layout_marginTop="6dp"
        android:textSize="13sp" />

</LinearLayout>